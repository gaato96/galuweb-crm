# Variables de entorno — Galu CRM
# Copiá este archivo a .env.local y completá los valores.
# En producción, cargalas en Vercel → Settings → Environment Variables.

# --- Acceso al panel (OBLIGATORIA) ---
# Sin esta variable el CRM queda bloqueado y muestra la pantalla de login
# con la advertencia correspondiente. Usá una clave larga y única.
CRM_PASSWORD=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# --- Google Places API (módulo Scraper) ---
# Se factura por consulta y por campos solicitados. Restringí la key por API
# y por referrer/IP en Google Cloud Console.
GOOGLE_PLACES_API_KEY=

# --- Gemini (investigación de contactos y redacción de mensajes en frío) ---
# También lee el texto de las reseñas en el escaneo automático de Prospección
# para encontrar la queja de nivel 1. Sin esta variable el escaneo igual corre:
# detecta las señales que no necesitan IA y deja la queja para buscarla a mano.
GEMINI_API_KEY=

# --- Google Custom Search (señal "no aparece al buscar su rubro + ciudad") ---
# Es la señal de mayor peso del catálogo (88) y la que más aparece en la lista.
# Sin estas dos variables el escaneo cae a DuckDuckGo, que es otro índice: la
# señal se marca igual pero avisando que hay que confirmarla antes de mandar.
#
# Cómo obtenerlas:
#   1. https://programmablesearchengine.google.com → crear un buscador que
#      busque en TODA la web (no en sitios específicos) → copiar el ID → CSE_ID.
#   2. Google Cloud Console → habilitar "Custom Search API" → crear una API key.
#      Puede ser la misma key de Places si le habilitás también esa API.
# Cuota: 100 consultas gratis por día. El escaneo gasta 1 por prospecto, y una
# segunda solo cuando el prospecto NO aparece (el control por nombre exacto).
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=
