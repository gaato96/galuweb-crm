# Variables de entorno — Galu CRM
# Copiá este archivo a .env.local y completá los valores.
# En producción, cargalas en Vercel → Settings → Environment Variables.

# --- Acceso al panel (OBLIGATORIA) ---
# Sin esta variable el CRM queda bloqueado y muestra la pantalla de login
# con la advertencia correspondiente. Usá una clave larga y única.
CRM_PASSWORD=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# --- Google Places API (módulo Scraper) ---
# Se factura por consulta y por campos solicitados. Restringí la key por API
# y por referrer/IP en Google Cloud Console.
GOOGLE_PLACES_API_KEY=

# --- Gemini (investigación de contactos y redacción de mensajes en frío) ---
GEMINI_API_KEY=
